# Punarshuru Environment Template — copy to .env and fill in values
DATABASE_URL=mysql+pymysql://punarshuru:punarshuru123@localhost:3306/punarshuru

# Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq API Configuration (Addendum v2)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3

# Security & CORS
SECRET_KEY=change-me-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# General
DEBUG=false
